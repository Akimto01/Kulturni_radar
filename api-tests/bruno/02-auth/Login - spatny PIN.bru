meta {
  name: Login - spatny PIN
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}
  body: json
  auth: none
}

body:json {
  {
    "akce": "login",
    "uzivatelId": "{{testUserId}}",
    "pin": "0000-jiste-spatny-pin"
  }
}

tests {
  test("status je 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("ok je false", function () {
    expect(res.getBody().ok).to.equal(false);
  });

  test("odpoved obsahuje chybovou hlasku", function () {
    expect(res.getBody()).to.have.property('error');
  });
}
